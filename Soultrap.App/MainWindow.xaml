<Window x:Class="Soultrap.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="SOULTRAP" Width="1180" Height="800" MinWidth="920" MinHeight="630" WindowStartupLocation="CenterScreen">
 <DockPanel Background="{DynamicResource Surface}">
  <Border DockPanel.Dock="Top" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="18,12">
   <DockPanel><StackPanel DockPanel.Dock="Left" Orientation="Horizontal"><Image Source="{Binding BrandIcon, Mode=OneWay}" Width="28" Height="28" Margin="0,0,10,0"/><TextBlock Text="SOULTRAP" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/></StackPanel>
    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="Developer Console" Command="{Binding Action}" CommandParameter="Owner"/><Button Content="Save settings" Command="{Binding Action}" CommandParameter="SaveSettings" Style="{StaticResource PrimaryButton}"/></StackPanel>
    <TextBox x:Name="NavigationSearch" Width="240" HorizontalAlignment="Center" TextChanged="NavigationSearch_TextChanged" ToolTip="Search sections and settings (Ctrl+K)" AutomationProperties.Name="Search navigation"/>
   </DockPanel>
  </Border>
  <StatusBar DockPanel.Dock="Bottom"><StatusBarItem><TextBlock Text="{Binding Status}" MaxWidth="1000"/></StatusBarItem><ProgressBar IsIndeterminate="{Binding Busy}" Width="70" Height="10"/></StatusBar>
  <Border x:Name="ErrorSurface" Background="{DynamicResource Panel}" DockPanel.Dock="Bottom" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="6"><TextBox Text="{Binding LastError, Mode=OneWay}" IsReadOnly="True" BorderThickness="0" Background="Transparent" Foreground="#E37979" TextWrapping="Wrap" MaxHeight="60" ToolTip="Copyable last error. See Diagnostics for structured logs."/></Border>
  <TabControl x:Name="Pages" Style="{StaticResource NavigationTabs}" IsEnabled="{Binding Idle}">
   <TabItem Header="Home" Tag="⌂"><ScrollViewer><StackPanel>
    <TextBlock Text="Your Roblox workspace" Style="{StaticResource Title}"/>
    <TextBlock Text="Client customization, presets and launch tools. All in one place."/>
    <GroupBox Header="Client information"><StackPanel><TextBlock Text="{Binding ClientDetails}"/><ComboBox ItemsSource="{Binding Clients}" DisplayMemberPath="Root" SelectedItem="{Binding SelectedClient}" ToolTip="Select the exact installed client version to inspect or customize."/><TextBlock Text="{Binding Compatibility}"/></StackPanel></GroupBox>
    <WrapPanel><Button Style="{StaticResource PrimaryButton}" Content="▶  PLAY ROBLOX" FontSize="18" Padding="28,13" Command="{Binding Action}" CommandParameter="Play" ToolTip="Launch the selected, Authenticode-verified Roblox client with --app."/><Button Content="Refresh Client" Command="{Binding Action}" CommandParameter="Refresh"/><Button Content="Install / Update Roblox…" Command="{Binding Action}" CommandParameter="RobloxDownload"/></WrapPanel>
    <WrapPanel><Button Content="Check Soultrap Updates" Command="{Binding Action}" CommandParameter="Updates"/><Button Content="Open Roblox Folder" Command="{Binding Action}" CommandParameter="ClientFolder"/><Button Content="Apply Preset" Command="{Binding Action}" CommandParameter="ApplyPreset"/><Button Content="Restore Defaults" Command="{Binding Action}" CommandParameter="Defaults"/><Button Content="View Logs" Command="{Binding Action}" CommandParameter="Logs"/></WrapPanel>
    <GroupBox Header="Update information"><StackPanel><TextBlock Text="{Binding UpdateText}"/><Button Content="Download verified release archive…" HorizontalAlignment="Left" Command="{Binding Action}" CommandParameter="DownloadUpdate" ToolTip="Requires a GitHub SHA-256 digest. Downloads only; never auto-executes."/></StackPanel></GroupBox>
   </StackPanel></ScrollViewer></TabItem>
   <TabItem Header="Customization" Tag="◇"><StackPanel><TextBlock Text="Roblox Customization Engine" Style="{StaticResource Title}"/><TextBlock Text="Only supported content files are changed. Close Roblox first. Every application records the exact client version and original bytes before writing. New versions require a fresh compatibility check and explicit application."/><GroupBox Header="Compatibility"><TextBlock Text="{Binding Compatibility}"/></GroupBox><WrapPanel><Button Content="Validate Client" Command="{Binding Action}" CommandParameter="ValidateClient"/><Button Content="Back Up Cursor Files" Command="{Binding Action}" CommandParameter="Snapshot"/><Button Content="Restore Latest Change" Command="{Binding Action}" CommandParameter="RestoreLatest"/></WrapPanel><TextBlock Text="DLL injection, process memory modification, anticheat bypasses, and CoreGui replacements are not supported."/></StackPanel></TabItem>
   <TabItem Header="Classic Roblox" Tag="▦"><StackPanel><TextBlock Text="Classic Roblox — interactive preview" Style="{StaticResource Title}"/><TextBlock Text="PREVIEW ONLY — this does not replace the in-game menu, HUD, or CoreGui. Current client support for historic menus is not established." FontWeight="SemiBold"/><ComboBox ItemsSource="{Binding ClassicStyles}" SelectedItem="{Binding ClassicStyle}"/><Border BorderBrush="#657C8C" BorderThickness="2" Background="{Binding ClassicBackground}" Margin="6,18" Padding="12" Height="260"><DockPanel><TextBlock DockPanel.Dock="Top" Text="{Binding ClassicPreviewCaption}" Foreground="#213A44" FontWeight="Bold"/><WrapPanel DockPanel.Dock="Top"><Button Content="Menu" Click="PreviewMenu"/><Button Content="Backpack" Click="PreviewBackpack"/><Button Content="Chat" Click="PreviewChat"/></WrapPanel><TextBlock x:Name="PreviewContent" Text="A local historical-style sandbox. Choose Menu, Backpack or Chat." Foreground="#213A44" Margin="12"/></DockPanel></Border></StackPanel></TabItem>
   <TabItem Header="Cursors" Tag="↖"><ScrollViewer><StackPanel><TextBlock Text="Legacy Cursor Manager" Style="{StaticResource Title}"/><ComboBox ItemsSource="{Binding CursorPresets}" DisplayMemberPath="Name" SelectedItem="{Binding SelectedCursor}"/><TextBlock Text="{Binding CursorDescription}"/><Border Background="#D4E4EF" BorderBrush="#91AEC4" BorderThickness="1" Width="180" Height="120" HorizontalAlignment="Left" Margin="4,12"><Image Source="{Binding CursorPreview}" Stretch="None" RenderOptions.BitmapScalingMode="NearestNeighbor"/></Border><WrapPanel><Button Content="Apply Cursor" Command="{Binding Action}" CommandParameter="ApplyCursor"/><Button Content="Restore" Command="{Binding Action}" CommandParameter="RestoreLatest"/></WrapPanel><GroupBox Header="Cursor Studio"><StackPanel><TextBlock Text="Import your PNG, resize, and place the click point at the image centre for Roblox PNG replacement. Export also saves hotspot metadata for editing; Roblox does not read that metadata."/><WrapPanel><Button Content="Import PNG…" Command="{Binding Action}" CommandParameter="ImportCursor"/><TextBlock Text="Size (8–128)" VerticalAlignment="Center"/><TextBox Text="{Binding CursorSize}" Width="50"/><TextBlock Text="Source click X / Y" VerticalAlignment="Center"/><TextBox Text="{Binding HotspotX}" Width="45"/><TextBox Text="{Binding HotspotY}" Width="45"/><Button Content="Render Preview" Command="{Binding Action}" CommandParameter="RenderCursor"/><Button Content="Export / Save Custom Preset…" Command="{Binding Action}" CommandParameter="ExportCursor"/></WrapPanel></StackPanel></GroupBox></StackPanel></ScrollViewer></TabItem>
   <TabItem Header="FastFlags" Tag="⚑"><StackPanel><TextBlock Text="FastFlags — local JSON editor" Style="{StaticResource Title}"/><TextBlock Text="{Binding FlagStatus}"/><WrapPanel><TextBox Text="{Binding FlagSearch}" Width="200" ToolTip="Search flag name or value"/><ComboBox ItemsSource="{Binding FlagCategories}" SelectedItem="{Binding FlagCategory}"/><Button Content="Search / Validate" Command="{Binding Action}" CommandParameter="ValidateFlags"/><Button Content="Import…" Command="{Binding Action}" CommandParameter="ImportFlags"/><Button Content="Export…" Command="{Binding Action}" CommandParameter="ExportFlags"/></WrapPanel><TextBox Text="{Binding FlagsJson}" Style="{StaticResource Editor}" Height="260"/><TextBlock Text="{Binding FlagResults}"/><TextBlock Text="No FastFlags are written to Roblox. Keep exports as backups; import one to restore the local editor."/></StackPanel></TabItem>
   <TabItem Header="Presets" Tag="▤"><StackPanel><TextBlock Text="Preset Manager" Style="{StaticResource Title}"/><ComboBox ItemsSource="{Binding PresetNames}" SelectedIndex="0" SelectedItem="{Binding SelectedPresetName}"/><WrapPanel><Button Content="Load" Command="{Binding Action}" CommandParameter="LoadPreset"/><Button Content="Apply" Command="{Binding Action}" CommandParameter="ApplyPreset"/><Button Content="New" Command="{Binding Action}" CommandParameter="NewPreset"/><Button Content="Duplicate" Command="{Binding Action}" CommandParameter="DuplicatePreset"/><Button Content="Save / Rename" Command="{Binding Action}" CommandParameter="SavePreset"/><Button Content="Delete" Command="{Binding Action}" CommandParameter="DeletePreset"/><Button Content="Import…" Command="{Binding Action}" CommandParameter="ImportPreset"/><Button Content="Export…" Command="{Binding Action}" CommandParameter="ExportPreset"/></WrapPanel><TextBlock Text="Edit name and properties below. ClassicPreview is local only. Nonempty Flags block application until allowlist verification. Cursor application is backed up and can be undone."/><TextBox Text="{Binding PresetJson}" Style="{StaticResource Editor}" Height="300"/><Button Content="Restore Previous Client State" HorizontalAlignment="Left" Command="{Binding Action}" CommandParameter="RestoreLatest"/></StackPanel></TabItem>
   <TabItem Header="Mods" Tag="⊞"><StackPanel><TextBlock Text="Compatible Mod Packages" Style="{StaticResource Title}"/><TextBlock Text="ZIP packages contain mod.json and up to two cursor PNG files. Exact version matching is mandatory. Scripts, executables, extra files and paths outside cursor targets are rejected."/><WrapPanel><Button Content="Inspect ZIP…" Command="{Binding Action}" CommandParameter="InspectMod"/><Button Content="Install / Enable" Command="{Binding Action}" CommandParameter="ApplyMod"/><Button Content="Disable Latest Change" Command="{Binding Action}" CommandParameter="RestoreLatest"/><Button Content="Remove Imported Package" Command="{Binding Action}" CommandParameter="RemoveMod"/></WrapPanel><TextBox Text="{Binding ModDetails, Mode=OneWay}" IsReadOnly="True" Style="{StaticResource Editor}" Height="250"/><TextBlock Text="Disable restores the latest journal, including cursor/preset changes. Select a specific change in Diagnostics. Package content is held in memory and never executed."/></StackPanel></TabItem>
   <TabItem Header="Diagnostics" Tag="⌁"><StackPanel><TextBlock Text="Diagnostics &amp; Backups" Style="{StaticResource Title}"/><WrapPanel><Button Content="Run Diagnostics" Command="{Binding Action}" CommandParameter="Diagnostics"/><Button Content="View Logs" Command="{Binding Action}" CommandParameter="Logs"/><Button Content="Open Data Folder" Command="{Binding Action}" CommandParameter="DataFolder"/></WrapPanel><TextBox Text="{Binding DiagnosticText, Mode=OneWay}" IsReadOnly="True" Style="{StaticResource Editor}" Height="130"/><ListBox ItemsSource="{Binding Backups}" SelectedItem="{Binding SelectedBackup}" Height="190"/><WrapPanel><Button Content="Refresh Backups" Command="{Binding Action}" CommandParameter="Backups"/><Button Content="Create" Command="{Binding Action}" CommandParameter="Snapshot"/><Button Content="Restore Selected" Command="{Binding Action}" CommandParameter="RestoreSelected"/><Button Content="Delete Restored Backup" Command="{Binding Action}" CommandParameter="DeleteBackup"/></WrapPanel></StackPanel></TabItem>
   <TabItem Header="Settings" Tag="⚙"><ScrollViewer><StackPanel><TextBlock Text="Settings" Style="{StaticResource Title}"/><GroupBox Header="Launcher / Startup"><StackPanel>
 <CheckBox Content="Show startup loading screen" IsChecked="{Binding Config.ShowSplashScreen}"/>
 <TextBlock Text="Startup screen style"/><ComboBox ItemsSource="{Binding SplashStyles}" SelectedItem="{Binding Config.SplashStyle}"/>
 <TextBlock Text="Startup title"/><TextBox Text="{Binding Config.SplashTitle}"/>
 <CheckBox Content="Keep Soultrap above other windows" IsChecked="{Binding Config.AlwaysOnTop}"/>
 </StackPanel></GroupBox><GroupBox Header="Appearance"><StackPanel><ComboBox ItemsSource="{Binding Themes}" SelectedItem="{Binding Config.Theme}"/><TextBlock Text="Custom accent (#RRGGBB)"/><TextBox Text="{Binding Config.CustomAccent}"/><TextBlock Text="Opacity (0.75–1.0)"/><Slider Minimum="0.75" Maximum="1" Value="{Binding Config.Opacity}"/><TextBlock Text="Interface scale (0.85–1.50)"/><Slider Minimum="0.85" Maximum="1.5" Value="{Binding Config.UiScale}" TickFrequency="0.05" IsSnapToTickEnabled="True"/>
 <TextBlock Text="Sidebar width (180–280)"/><Slider Minimum="180" Maximum="280" Value="{Binding Config.SidebarWidth}"/>
 <TextBlock Text="Editor font size (10–24)"/><Slider Minimum="10" Maximum="24" Value="{Binding Config.EditorFontSize}" TickFrequency="1" IsSnapToTickEnabled="True"/>
 <CheckBox Content="Wrap lines in JSON editors" IsChecked="{Binding Config.EditorWordWrap}"/>
 <CheckBox Content="Software rendering (compatibility mode)" IsChecked="{Binding Config.SoftwareRendering}"/>
 <CheckBox Content="Animate theme transitions" IsChecked="{Binding Config.Animations}"/><CheckBox Content="Interface notification sounds" IsChecked="{Binding Config.Sounds}"/></StackPanel></GroupBox><GroupBox Header="General / Roblox"><StackPanel><TextBlock Text="Interface language: English (additional translations unavailable)"/><CheckBox Content="Check Soultrap updates on startup" IsChecked="{Binding Config.CheckUpdates}"/><CheckBox Content="Start with Windows" IsChecked="{Binding AutoStart}"/><CheckBox Content="Minimize to notification area" IsChecked="{Binding MinimizeToTray}"/><CheckBox Content="Confirm before launching Roblox" IsChecked="{Binding Config.ConfirmLaunches}"/>
 <TextBlock Text="After launching Roblox"/><ComboBox ItemsSource="{Binding AfterLaunchOptions}" SelectedItem="{Binding Config.AfterLaunch}"/>
 <TextBlock Text="Client process priority (takes effect on next direct launch)"/><ComboBox ItemsSource="{Binding ProcessPriorities}" SelectedItem="{Binding Config.ProcessPriority}"/>
 <TextBlock Text="Roblox version directory or Versions directory (blank = auto-detect)"/><TextBox Text="{Binding Config.RobloxPath}"/><TextBlock Text="Optional roblox-player launch URI (contains sensitive tickets: never paste it into logs)"/><TextBox Text="{Binding Config.LaunchUri}"/><Button Content="Launch Configured URI" HorizontalAlignment="Left" Command="{Binding Action}" CommandParameter="LaunchUri"/></StackPanel></GroupBox><WrapPanel><Button Content="Save / Apply Settings" Command="{Binding Action}" CommandParameter="SaveSettings"/><Button Content="Import Configuration…" Command="{Binding Action}" CommandParameter="ImportSettings"/><Button Content="Export Configuration…" Command="{Binding Action}" CommandParameter="ExportSettings"/><Button Content="Reset Launcher Settings" Command="{Binding Action}" CommandParameter="ResetSettings"/></WrapPanel></StackPanel></ScrollViewer></TabItem>
 <TabItem Header="Integrations" Tag="⤴"><ScrollViewer><StackPanel>
  <TextBlock Text="Integrations &amp; shortcuts" Style="{StaticResource Title}"/>
  <GroupBox Header="Local activity tracking"><StackPanel><CheckBox Content="Monitor Roblox process status" IsChecked="{Binding Config.TrackRobloxProcess}"/><TextBlock Text="Updates Home while Soultrap is open. No account names or activity are uploaded."/><TextBlock Text="{Binding RobloxStatus, Mode=OneWay}"/></StackPanel></GroupBox>
  <GroupBox Header="Windows shortcuts"><StackPanel><TextBlock Text="Create shortcuts to this installed Soultrap.exe."/><WrapPanel><Button Content="Create desktop shortcut" Command="{Binding Action}" CommandParameter="DesktopShortcut"/><Button Content="Create Start menu shortcut" Command="{Binding Action}" CommandParameter="StartMenuShortcut"/></WrapPanel></StackPanel></GroupBox>
  <TextBlock Text="Discord Rich Presence, arbitrary program integrations, cookie access and game-account features are not implemented. Their upstream options are listed with explicit status in Upstream Settings."/>
 </StackPanel></ScrollViewer></TabItem>
 <TabItem Header="Maintenance" Tag="↺"><ScrollViewer><StackPanel>
  <TextBlock Text="Storage &amp; maintenance" Style="{StaticResource Title}"/>
  <GroupBox Header="Log cleaner"><StackPanel><TextBlock Text="Keep logs for this many days (1–365)"/><TextBox Width="110" HorizontalAlignment="Left" Text="{Binding Config.LogRetentionDays}"/><TextBlock Text="Deletes only older .log/.jsonl/.previous files directly inside Soultrap and Roblox log folders. Current Soultrap log, client versions, backups and user content are retained. Close Roblox first."/><Button HorizontalAlignment="Left" Content="Clean old logs…" Command="{Binding Action}" CommandParameter="CleanLogs"/></StackPanel></GroupBox>
  <WrapPanel><Button Content="Open Soultrap data" Command="{Binding Action}" CommandParameter="DataFolder"/><Button Content="Open Roblox logs" Command="{Binding Action}" CommandParameter="RobloxLogs"/><Button Content="Open backups" Command="{Binding Action}" CommandParameter="BackupsFolder"/></WrapPanel>
 </StackPanel></ScrollViewer></TabItem>
 <TabItem Header="Upstream Settings" Tag="☷"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel><TextBlock Text="Bloxstrap · Fishstrap · Voidstrap" Style="{StaticResource Title}"/><TextBlock Text="Inventory of actual upstream settings. Adapted options work in Soultrap; other rows are reference entries, not active switches."/></StackPanel>
  <WrapPanel Grid.Row="1"><TextBox Text="{Binding UpstreamSearch, UpdateSourceTrigger=PropertyChanged}" Width="230" ToolTip="Search setting names or behavior"/><ComboBox ItemsSource="{Binding UpstreamProjects}" SelectedItem="{Binding UpstreamProject}"/><Button Content="Import supported upstream settings…" Command="{Binding Action}" CommandParameter="ImportUpstream"/></WrapPanel>
  <TextBlock Grid.Row="2" Text="{Binding UpstreamSummary, Mode=OneWay}" Foreground="{DynamicResource Muted}"/>
  <ListView Grid.Row="3" ItemsSource="{Binding VisibleUpstreamSettings}"><ListView.View><GridView><GridViewColumn Header="Project" DisplayMemberBinding="{Binding Project}" Width="90"/><GridViewColumn Header="Setting" DisplayMemberBinding="{Binding Name}" Width="230"/><GridViewColumn Header="Status" DisplayMemberBinding="{Binding Status}" Width="130"/><GridViewColumn Header="Soultrap behavior" DisplayMemberBinding="{Binding Destination}" Width="430"/></GridView></ListView.View></ListView>
  <TextBlock Grid.Row="4" Text="Source commits, MIT notices and exact compatibility mapping: SETTINGS-COMPATIBILITY.md. Unsupported upstream keys are reported during import and never silently activated."/>
 </Grid></TabItem>

  </TabControl>
 </DockPanel>
</Window>
