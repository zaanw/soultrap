<Window x:Class="Soultrap.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="SOULTRAP — Ultimate Aero" Width="1100" Height="780" MinWidth="920" MinHeight="630" WindowStartupLocation="CenterScreen">
 <DockPanel>
  <Border DockPanel.Dock="Top" BorderBrush="#77A9D0" BorderThickness="0,0,0,1" Padding="16,10"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#F3FCFF"/><GradientStop Color="#A4D4F2" Offset="0.49"/><GradientStop Color="#83BBE6" Offset="0.5"/><GradientStop Color="#D9EFFD" Offset="1"/></LinearGradientBrush></Border.Background><DockPanel><TextBlock Text="SOULTRAP" FontSize="25" FontWeight="Light" Foreground="#153B5C"/><TextBlock Text="ULTIMATE AERO  /  Roblox customization workbench" VerticalAlignment="Center" Margin="18,0" Foreground="#245272"/><Button DockPanel.Dock="Right" Content="Developer Console" Command="{Binding Action}" CommandParameter="Owner" ToolTip="Authenticate as the current Windows account; no Roblox privileges."/></DockPanel></Border>
  <StatusBar DockPanel.Dock="Bottom"><StatusBarItem><TextBlock Text="{Binding Status}" MaxWidth="1000"/></StatusBarItem><ProgressBar IsIndeterminate="{Binding Busy}" Width="70" Height="10"/></StatusBar>
  <Border DockPanel.Dock="Bottom" BorderBrush="#9CB9D0" BorderThickness="0,1,0,0" Padding="6"><TextBox Text="{Binding LastError}" IsReadOnly="True" BorderThickness="0" Background="Transparent" Foreground="#A62820" TextWrapping="Wrap" MaxHeight="60" ToolTip="Copyable last error. See Diagnostics for structured logs."/></Border>
  <TabControl Margin="9" IsEnabled="{Binding Idle}">
   <TabItem Header="Home"><ScrollViewer><StackPanel>
    <TextBlock Text="Welcome to Soultrap" Style="{StaticResource Title}"/>
    <TextBlock Text="Your Roblox client, with a little more character."/>
    <GroupBox Header="Client information"><StackPanel><TextBlock Text="{Binding ClientDetails}"/><ComboBox ItemsSource="{Binding Clients}" DisplayMemberPath="Root" SelectedItem="{Binding SelectedClient}" ToolTip="Select the exact installed client version to inspect or customize."/><TextBlock Text="{Binding Compatibility}"/></StackPanel></GroupBox>
    <WrapPanel><Button Content="▶  PLAY ROBLOX" FontSize="18" Padding="28,13" Command="{Binding Action}" CommandParameter="Play" ToolTip="Launch the selected, Authenticode-verified Roblox client with --app."/><Button Content="Refresh Client" Command="{Binding Action}" CommandParameter="Refresh"/><Button Content="Install / Update Roblox…" Command="{Binding Action}" CommandParameter="RobloxDownload"/></WrapPanel>
    <WrapPanel><Button Content="Check Soultrap Updates" Command="{Binding Action}" CommandParameter="Updates"/><Button Content="Open Roblox Folder" Command="{Binding Action}" CommandParameter="ClientFolder"/><Button Content="Apply Preset" Command="{Binding Action}" CommandParameter="ApplyPreset"/><Button Content="Restore Defaults" Command="{Binding Action}" CommandParameter="Defaults"/><Button Content="View Logs" Command="{Binding Action}" CommandParameter="Logs"/></WrapPanel>
    <GroupBox Header="Update information"><StackPanel><TextBlock Text="{Binding UpdateText}"/><Button Content="Download verified release archive…" HorizontalAlignment="Left" Command="{Binding Action}" CommandParameter="DownloadUpdate" ToolTip="Requires a GitHub SHA-256 digest. Downloads only; never auto-executes."/></StackPanel></GroupBox>
   </StackPanel></ScrollViewer></TabItem>
   <TabItem Header="Customization"><StackPanel><TextBlock Text="Roblox Customization Engine" Style="{StaticResource Title}"/><TextBlock Text="Only supported content files are changed. Close Roblox first. Every application records the exact client version and original bytes before writing. New versions require a fresh compatibility check and explicit application."/><GroupBox Header="Compatibility"><TextBlock Text="{Binding Compatibility}"/></GroupBox><WrapPanel><Button Content="Validate Client" Command="{Binding Action}" CommandParameter="ValidateClient"/><Button Content="Back Up Cursor Files" Command="{Binding Action}" CommandParameter="Snapshot"/><Button Content="Restore Latest Change" Command="{Binding Action}" CommandParameter="RestoreLatest"/></WrapPanel><TextBlock Text="DLL injection, process memory modification, anticheat bypasses, and CoreGui replacements are not supported."/></StackPanel></TabItem>
   <TabItem Header="Classic Roblox"><StackPanel><TextBlock Text="Classic Roblox — interactive preview" Style="{StaticResource Title}"/><TextBlock Text="PREVIEW ONLY — this does not replace the in-game menu, HUD, or CoreGui. Current client support for historic menus is not established." FontWeight="SemiBold"/><ComboBox ItemsSource="{Binding ClassicStyles}" SelectedItem="{Binding ClassicStyle}"/><Border BorderBrush="#657C8C" BorderThickness="2" Background="{Binding ClassicBackground}" Margin="6,18" Padding="12" Height="260"><DockPanel><TextBlock DockPanel.Dock="Top" Text="{Binding ClassicPreviewCaption}" Foreground="#213A44" FontWeight="Bold"/><WrapPanel DockPanel.Dock="Top"><Button Content="Menu" Click="PreviewMenu"/><Button Content="Backpack" Click="PreviewBackpack"/><Button Content="Chat" Click="PreviewChat"/></WrapPanel><TextBlock x:Name="PreviewContent" Text="A local historical-style sandbox. Choose Menu, Backpack or Chat." Foreground="#213A44" Margin="12"/></DockPanel></Border></StackPanel></TabItem>
   <TabItem Header="Cursors"><ScrollViewer><StackPanel><TextBlock Text="Legacy Cursor Manager" Style="{StaticResource Title}"/><ComboBox ItemsSource="{Binding CursorPresets}" DisplayMemberPath="Name" SelectedItem="{Binding SelectedCursor}"/><TextBlock Text="{Binding CursorDescription}"/><Border Background="#D4E4EF" BorderBrush="#91AEC4" BorderThickness="1" Width="180" Height="120" HorizontalAlignment="Left" Margin="4,12"><Image Source="{Binding CursorPreview}" Stretch="None" RenderOptions.BitmapScalingMode="NearestNeighbor"/></Border><WrapPanel><Button Content="Apply Cursor" Command="{Binding Action}" CommandParameter="ApplyCursor"/><Button Content="Restore" Command="{Binding Action}" CommandParameter="RestoreLatest"/></WrapPanel><GroupBox Header="Cursor Studio"><StackPanel><TextBlock Text="Import your PNG, resize, and place the click point at the image centre for Roblox PNG replacement. Export also saves hotspot metadata for editing; Roblox does not read that metadata."/><WrapPanel><Button Content="Import PNG…" Command="{Binding Action}" CommandParameter="ImportCursor"/><TextBlock Text="Size (8–128)" VerticalAlignment="Center"/><TextBox Text="{Binding CursorSize}" Width="50"/><TextBlock Text="Source click X / Y" VerticalAlignment="Center"/><TextBox Text="{Binding HotspotX}" Width="45"/><TextBox Text="{Binding HotspotY}" Width="45"/><Button Content="Render Preview" Command="{Binding Action}" CommandParameter="RenderCursor"/><Button Content="Export / Save Custom Preset…" Command="{Binding Action}" CommandParameter="ExportCursor"/></WrapPanel></StackPanel></GroupBox></StackPanel></ScrollViewer></TabItem>
   <TabItem Header="FastFlags"><StackPanel><TextBlock Text="FastFlags — local JSON editor" Style="{StaticResource Title}"/><TextBlock Text="{Binding FlagStatus}"/><WrapPanel><TextBox Text="{Binding FlagSearch}" Width="200" ToolTip="Search flag name or value"/><ComboBox ItemsSource="{Binding FlagCategories}" SelectedItem="{Binding FlagCategory}"/><Button Content="Search / Validate" Command="{Binding Action}" CommandParameter="ValidateFlags"/><Button Content="Import…" Command="{Binding Action}" CommandParameter="ImportFlags"/><Button Content="Export…" Command="{Binding Action}" CommandParameter="ExportFlags"/></WrapPanel><TextBox Text="{Binding FlagsJson}" Style="{StaticResource Editor}" Height="260"/><TextBlock Text="{Binding FlagResults}"/><TextBlock Text="No FastFlags are written to Roblox. Keep exports as backups; import one to restore the local editor."/></StackPanel></TabItem>
   <TabItem Header="Presets"><StackPanel><TextBlock Text="Preset Manager" Style="{StaticResource Title}"/><ComboBox ItemsSource="{Binding PresetNames}" SelectedIndex="0" SelectedItem="{Binding SelectedPresetName}"/><WrapPanel><Button Content="Load" Command="{Binding Action}" CommandParameter="LoadPreset"/><Button Content="Apply" Command="{Binding Action}" CommandParameter="ApplyPreset"/><Button Content="New" Command="{Binding Action}" CommandParameter="NewPreset"/><Button Content="Duplicate" Command="{Binding Action}" CommandParameter="DuplicatePreset"/><Button Content="Save / Rename" Command="{Binding Action}" CommandParameter="SavePreset"/><Button Content="Delete" Command="{Binding Action}" CommandParameter="DeletePreset"/><Button Content="Import…" Command="{Binding Action}" CommandParameter="ImportPreset"/><Button Content="Export…" Command="{Binding Action}" CommandParameter="ExportPreset"/></WrapPanel><TextBlock Text="Edit name and properties below. ClassicPreview is local only. Nonempty Flags block application until allowlist verification. Cursor application is backed up and can be undone."/><TextBox Text="{Binding PresetJson}" Style="{StaticResource Editor}" Height="300"/><Button Content="Restore Previous Client State" HorizontalAlignment="Left" Command="{Binding Action}" CommandParameter="RestoreLatest"/></StackPanel></TabItem>
   <TabItem Header="Mods"><StackPanel><TextBlock Text="Compatible Mod Packages" Style="{StaticResource Title}"/><TextBlock Text="ZIP packages contain mod.json and up to two cursor PNG files. Exact version matching is mandatory. Scripts, executables, extra files and paths outside cursor targets are rejected."/><WrapPanel><Button Content="Inspect ZIP…" Command="{Binding Action}" CommandParameter="InspectMod"/><Button Content="Install / Enable" Command="{Binding Action}" CommandParameter="ApplyMod"/><Button Content="Disable Latest Change" Command="{Binding Action}" CommandParameter="RestoreLatest"/><Button Content="Remove Imported Package" Command="{Binding Action}" CommandParameter="RemoveMod"/></WrapPanel><TextBox Text="{Binding ModDetails}" IsReadOnly="True" Style="{StaticResource Editor}" Height="250"/><TextBlock Text="Disable restores the latest journal, including cursor/preset changes. Select a specific change in Diagnostics. Package content is held in memory and never executed."/></StackPanel></TabItem>
   <TabItem Header="Diagnostics"><StackPanel><TextBlock Text="Diagnostics &amp; Backups" Style="{StaticResource Title}"/><WrapPanel><Button Content="Run Diagnostics" Command="{Binding Action}" CommandParameter="Diagnostics"/><Button Content="View Logs" Command="{Binding Action}" CommandParameter="Logs"/><Button Content="Open Data Folder" Command="{Binding Action}" CommandParameter="DataFolder"/></WrapPanel><TextBox Text="{Binding DiagnosticText}" IsReadOnly="True" Style="{StaticResource Editor}" Height="130"/><ListBox ItemsSource="{Binding Backups}" SelectedItem="{Binding SelectedBackup}" Height="190"/><WrapPanel><Button Content="Refresh Backups" Command="{Binding Action}" CommandParameter="Backups"/><Button Content="Create" Command="{Binding Action}" CommandParameter="Snapshot"/><Button Content="Restore Selected" Command="{Binding Action}" CommandParameter="RestoreSelected"/><Button Content="Delete Restored Backup" Command="{Binding Action}" CommandParameter="DeleteBackup"/></WrapPanel></StackPanel></TabItem>
   <TabItem Header="Settings"><ScrollViewer><StackPanel><TextBlock Text="Settings" Style="{StaticResource Title}"/><GroupBox Header="Appearance"><StackPanel><ComboBox ItemsSource="{Binding Themes}" SelectedItem="{Binding Config.Theme}"/><TextBlock Text="Custom accent (#RRGGBB)"/><TextBox Text="{Binding Config.CustomAccent}"/><TextBlock Text="Opacity (0.75–1.0)"/><Slider Minimum="0.75" Maximum="1" Value="{Binding Config.Opacity}"/><CheckBox Content="Animate theme transitions" IsChecked="{Binding Config.Animations}"/><CheckBox Content="Interface notification sounds" IsChecked="{Binding Config.Sounds}"/></StackPanel></GroupBox><GroupBox Header="General / Roblox"><StackPanel><TextBlock Text="Interface language: English (additional translations unavailable)"/><CheckBox Content="Check Soultrap updates on startup" IsChecked="{Binding Config.CheckUpdates}"/><CheckBox Content="Start with Windows" IsChecked="{Binding AutoStart}"/><CheckBox Content="Minimize to notification area" IsChecked="{Binding MinimizeToTray}"/><TextBlock Text="Roblox version directory or Versions directory (blank = auto-detect)"/><TextBox Text="{Binding Config.RobloxPath}"/><TextBlock Text="Optional roblox-player launch URI (contains sensitive tickets: never paste it into logs)"/><TextBox Text="{Binding Config.LaunchUri}"/><Button Content="Launch Configured URI" HorizontalAlignment="Left" Command="{Binding Action}" CommandParameter="LaunchUri"/></StackPanel></GroupBox><WrapPanel><Button Content="Save / Apply Settings" Command="{Binding Action}" CommandParameter="SaveSettings"/><Button Content="Import Configuration…" Command="{Binding Action}" CommandParameter="ImportSettings"/><Button Content="Export Configuration…" Command="{Binding Action}" CommandParameter="ExportSettings"/><Button Content="Reset Launcher Settings" Command="{Binding Action}" CommandParameter="ResetSettings"/></WrapPanel></StackPanel></ScrollViewer></TabItem>
  </TabControl>
 </DockPanel>
</Window>
