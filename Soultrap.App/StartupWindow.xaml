<Window x:Class="Soultrap.App.StartupWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Width="500" Height="280" WindowStyle="None" ResizeMode="NoResize" WindowStartupLocation="CenterScreen" ShowInTaskbar="True" Title="Soultrap — starting" Background="{DynamicResource Surface}">
 <Border BorderThickness="1" BorderBrush="{DynamicResource Line}" Padding="22">
  <Grid>
   <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
    <StackPanel.Style><Style TargetType="StackPanel"><Style.Triggers><DataTrigger Binding="{Binding Config.SplashStyle}" Value="Classic"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
    <Image Source="{Binding BrandIcon, Mode=OneWay}" Width="82" Height="82" Margin="0,0,0,14" RenderOptions.BitmapScalingMode="HighQuality"/>
    <TextBlock Text="{Binding Config.SplashTitle}" FontSize="16" TextAlignment="Center" HorizontalAlignment="Center"/>
    <TextBlock Text="{Binding StartupStatus, Mode=OneWay}" FontSize="12" Foreground="{DynamicResource Muted}" TextAlignment="Center" HorizontalAlignment="Center"/>
    <ProgressBar Width="420" Height="13" Margin="0,20,0,0" Foreground="{DynamicResource Accent}" Background="{DynamicResource Field}" Maximum="100" Value="{Binding StartupProgress, Mode=OneWay}"/>
   </StackPanel>
   <Grid>
    <Grid.Style><Style TargetType="Grid"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Config.SplashStyle}" Value="Classic"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Grid.Style>
    <Grid.ColumnDefinitions><ColumnDefinition Width="70"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Image Source="{Binding BrandIcon, Mode=OneWay}" Width="48" Height="48" VerticalAlignment="Center"/>
    <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="{Binding Config.SplashTitle}" FontSize="20"/><TextBlock Text="{Binding StartupStatus, Mode=OneWay}" Foreground="{DynamicResource Muted}"/><ProgressBar Margin="0,16,0,0" Height="8" Maximum="100" Value="{Binding StartupProgress, Mode=OneWay}" Foreground="{DynamicResource Accent}"/></StackPanel>
   </Grid>
  </Grid>
 </Border>
</Window>
