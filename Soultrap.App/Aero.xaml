<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <SolidColorBrush x:Key="Accent" Color="#267AC4"/><SolidColorBrush x:Key="Surface" Color="#EDF5FC"/><SolidColorBrush x:Key="Ink" Color="#19364C"/>
 <Style TargetType="Window"><Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="FontSize" Value="12"/><Setter Property="Background" Value="{DynamicResource Surface}"/><Setter Property="Foreground" Value="{DynamicResource Ink}"/></Style>
 <Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource Ink}"/><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="Margin" Value="0,3"/></Style>
 <Style TargetType="Button"><Setter Property="Padding" Value="12,5"/><Setter Property="Margin" Value="3"/><Setter Property="MinHeight" Value="28"/><Setter Property="BorderBrush" Value="#7E9DB9"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Foreground" Value="#18364A"/><Setter Property="Background"><Setter.Value><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#FFFFFF" Offset="0"/><GradientStop Color="#E9F4FD" Offset="0.48"/><GradientStop Color="#CDDFEE" Offset="0.5"/><GradientStop Color="#EFF8FF" Offset="1"/></LinearGradientBrush></Setter.Value></Setter><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="2"><ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="#2495E6"/><Setter TargetName="Chrome" Property="Effect"><Setter.Value><DropShadowEffect Color="#5AC7FF" BlurRadius="5" ShadowDepth="0" Opacity="0.65"/></Setter.Value></Setter></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Chrome" Property="Opacity" Value="0.65"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Chrome" Property="Opacity" Value="0.4"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
 <Style TargetType="GroupBox"><Setter Property="Margin" Value="4,8"/><Setter Property="Padding" Value="10"/><Setter Property="Foreground" Value="{DynamicResource Ink}"/><Setter Property="BorderBrush" Value="#9CB9D0"/></Style>
 <Style TargetType="TextBox"><Setter Property="Margin" Value="3"/><Setter Property="Padding" Value="4"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
 <Style TargetType="ComboBox"><Setter Property="Margin" Value="3"/><Setter Property="MinHeight" Value="27"/><Setter Property="MinWidth" Value="150"/></Style>
 <Style TargetType="CheckBox"><Setter Property="Margin" Value="5"/><Setter Property="Foreground" Value="{DynamicResource Ink}"/></Style>
 <Style TargetType="TabControl"><Setter Property="Background" Value="{DynamicResource Surface}"/><Setter Property="BorderBrush" Value="#9CB9D0"/><Setter Property="Padding" Value="8"/></Style>
 <Style TargetType="TabItem"><Setter Property="Padding" Value="9,6"/><Setter Property="Foreground" Value="#18364A"/></Style>
 <Style x:Key="Title" TargetType="TextBlock"><Setter Property="FontSize" Value="22"/><Setter Property="Foreground" Value="{DynamicResource Accent}"/><Setter Property="Margin" Value="3,5,3,12"/></Style>
 <Style x:Key="Editor" TargetType="TextBox"><Setter Property="FontFamily" Value="Consolas"/><Setter Property="AcceptsReturn" Value="True"/><Setter Property="AcceptsTab" Value="True"/><Setter Property="VerticalScrollBarVisibility" Value="Auto"/><Setter Property="HorizontalScrollBarVisibility" Value="Auto"/><Setter Property="MinHeight" Value="150"/><Setter Property="Margin" Value="3"/><Setter Property="Padding" Value="6"/></Style>
</ResourceDictionary>
