<Window x:Class="Soultrap.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Style="{StaticResource {x:Type Window}}" Title="SOULTRAP" Width="1180" Height="800" MinWidth="920" MinHeight="630" WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework">
 <shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="48" ResizeBorderThickness="6" GlassFrameThickness="0" UseAeroCaptionButtons="False"/></shell:WindowChrome.WindowChrome>
 <DockPanel Background="{DynamicResource Surface}">
  <Border DockPanel.Dock="Top" Height="48" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1">
   <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="{Binding Config.SidebarWidth}"/><ColumnDefinition Width="*"/><ColumnDefinition Width="138"/></Grid.ColumnDefinitions>
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0"><Image Source="{Binding BrandIcon, Mode=OneWay}" Width="22" Height="22" Margin="0,0,10,0"/><TextBlock Text="Soultrap" FontSize="14" FontWeight="SemiBold"/></StackPanel>
    <Grid Grid.Column="1" Width="260" Height="30" HorizontalAlignment="Center" shell:WindowChrome.IsHitTestVisibleInChrome="True"><TextBox x:Name="NavigationSearch" Padding="8,3" Margin="0" TextChanged="NavigationSearch_TextChanged" ToolTip="Search sections (Ctrl+K)" AutomationProperties.Name="Search navigation"/><TextBlock Text="Search sections…    Ctrl+K" Margin="10,0" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource Muted}" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=NavigationSearch}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid>
    <StackPanel Grid.Column="2" Orientation="Horizontal" shell:WindowChrome.IsHitTestVisibleInChrome="True"><Button Style="{StaticResource CaptionButton}" Content="−" Click="MinimizeWindow" ToolTip="Minimize" AutomationProperties.Name="Minimize"/><Button Style="{StaticResource CaptionButton}" Content="□" Click="MaximizeWindow" ToolTip="Maximize or restore" AutomationProperties.Name="Maximize or restore"/><Button Style="{StaticResource CloseCaptionButton}" Content="×" Click="CloseWindow" ToolTip="Close" AutomationProperties.Name="Close"/></StackPanel>
   </Grid>
  </Border>
  <StatusBar DockPanel.Dock="Bottom"><StatusBarItem><TextBlock Text="{Binding Status}" MaxWidth="1000"/></StatusBarItem><ProgressBar IsIndeterminate="{Binding Busy}" Width="70" Height="10"/></StatusBar>
  <Border x:Name="ErrorSurface" Background="{DynamicResource Panel}" DockPanel.Dock="Bottom" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="6"><TextBox Text="{Binding LastError, Mode=OneWay}" IsReadOnly="True" BorderThickness="0" Background="Transparent" Foreground="#E37979" TextWrapping="Wrap" MaxHeight="60" ToolTip="Copyable last error. See Diagnostics for structured logs."/></Border>
  <Border DockPanel.Dock="Bottom" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="12,8"><DockPanel><Button DockPanel.Dock="Left" Content="Owner profile" Command="{Binding Action}" CommandParameter="Owner"/><Button DockPanel.Dock="Right" Content="Save settings" Command="{Binding Action}" CommandParameter="SaveSettings" Style="{StaticResource PrimaryButton}"/><TextBlock Text="Settings are stored locally" VerticalAlignment="Center" Margin="16,0" Foreground="{DynamicResource Muted}" FontSize="12"/></DockPanel></Border>
  <Border DockPanel.Dock="Bottom" Background="{DynamicResource Panel}" Padding="16,10" Visibility="{Binding IsUpdating, Converter={StaticResource BoolToVisibility}}"><DockPanel><Button DockPanel.Dock="Right" Content="Cancel download" Command="{Binding CancelUpdate}"/><StackPanel><TextBlock Text="{Binding UpdateProgress, Mode=OneWay}"/><ProgressBar Height="5" Maximum="100" Value="{Binding UpdatePercent, Mode=OneWay}" IsIndeterminate="{Binding UpdateIndeterminate, Mode=OneWay}"/></StackPanel></DockPanel></Border>
  <TabControl x:Name="Pages" Style="{StaticResource NavigationTabs}" IsEnabled="{Binding Idle}">
   <TabItem Header="Home" Tag="M3,10 L12,3 L21,10 M6,9 L6,21 L18,21 L18,9 M10,21 L10,14 L14,14 L14,21" Uid="CORE"><ScrollViewer><StackPanel>
    <TextBlock Text="Roblox" Style="{StaticResource Title}"/><TextBlock x:Name="HomeSubtitle" Text="Launch, configure and personalize your client." Foreground="{DynamicResource Ink}"/>
    <Border Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="6" Padding="20" Margin="0,18,0,12"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="64"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <Image Source="{Binding BrandIcon, Mode=OneWay}" Width="44" Height="44" VerticalAlignment="Center" HorizontalAlignment="Left"/>
     <StackPanel Grid.Column="1"><TextBlock Text="Roblox Player" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="{Binding RobloxStatus, Mode=OneWay}" Foreground="{DynamicResource Muted}"/></StackPanel>
     <Button Grid.Column="2" Content="▶  Launch Roblox" Command="{Binding Action}" CommandParameter="Play" Style="{StaticResource PrimaryButton}" VerticalAlignment="Center" Padding="20,10"/>
    </Grid></Border>
    <TextBlock Text="Client installation" FontSize="14" FontWeight="SemiBold" Margin="0,12,0,6"/>
    <ComboBox ItemsSource="{Binding Clients}" DisplayMemberPath="Root" SelectedItem="{Binding SelectedClient}" ToolTip="Select your installed Win32 client"/>
    <TextBlock Text="{Binding ClientDetails}" Foreground="{DynamicResource Muted}"/>
    <WrapPanel Margin="0,8,0,14"><Button Content="Refresh" Command="{Binding Action}" CommandParameter="Refresh"/><Button Content="Install / repair Roblox…" Command="{Binding Action}" CommandParameter="RobloxDownload" ToolTip="Open the official Roblox download page"/><Button Content="Open client folder" Command="{Binding Action}" CommandParameter="ClientFolder"/></WrapPanel>
    <TextBlock Text="Quick access" FontSize="14" FontWeight="SemiBold"/>
    <WrapPanel><Button Content="Cursor Studio" Tag="Cursors" Click="NavigateShortcut"/><Button Content="Presets" Tag="Presets" Click="NavigateShortcut"/><Button Content="Diagnostics" Tag="Diagnostics" Click="NavigateShortcut"/><Button Content="Restore defaults" Command="{Binding Action}" CommandParameter="Defaults"/></WrapPanel>
    <Border Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="6" Padding="16" Margin="0,20,0,8"><StackPanel><DockPanel><TextBlock Text="Soultrap updates" FontWeight="SemiBold"/><Button DockPanel.Dock="Right" Content="Check" Command="{Binding Action}" CommandParameter="Updates"/></DockPanel><TextBlock Text="{Binding UpdateText, Mode=OneWay}" MaxHeight="90" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource Muted}"/><Button Content="Download and install update" Command="{Binding Action}" CommandParameter="InstallUpdate" IsEnabled="{Binding UpdateAvailable}" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left"/></StackPanel></Border>
   </StackPanel></ScrollViewer></TabItem>
   <TabItem Uid="ROBLOX" Header="Customization" Tag="M4,4 L20,4 L20,20 L4,20 Z M4,10 L20,10 M10,10 L10,20"><StackPanel><TextBlock Text="Roblox Customization Engine" Style="{StaticResource Title}"/><TextBlock Text="Only supported content files are changed. Close Roblox first. Every application records the exact client version and original bytes before writing. New versions require a fresh compatibility check and explicit application."/><GroupBox Header="Compatibility"><TextBlock Text="{Binding Compatibility}"/></GroupBox><WrapPanel><Button Content="Validate Client" Command="{Binding Action}" CommandParameter="ValidateClient"/><Button Content="Back Up Cursor Files" Command="{Binding Action}" CommandParameter="Snapshot"/><Button Content="Restore Latest Change" Command="{Binding Action}" CommandParameter="RestoreLatest"/></WrapPanel><TextBlock Text="DLL injection, process memory modification, anticheat bypasses, and CoreGui replacements are not supported."/></StackPanel></TabItem>
   <TabItem Header="Classic Roblox" Tag="M4,4 L20,4 L20,20 L4,20 Z M4,9 L20,9 M9,9 L9,20"><StackPanel><TextBlock Text="Classic Roblox — interactive preview" Style="{StaticResource Title}"/><TextBlock Text="PREVIEW ONLY — this does not replace the in-game menu, HUD, or CoreGui. Current client support for historic menus is not established." FontWeight="SemiBold"/><ComboBox ItemsSource="{Binding ClassicStyles}" SelectedItem="{Binding ClassicStyle}"/><Border BorderBrush="#657C8C" BorderThickness="2" Background="{Binding ClassicBackground}" Margin="6,18" Padding="12" Height="260"><DockPanel><TextBlock DockPanel.Dock="Top" Text="{Binding ClassicPreviewCaption}" Foreground="#213A44" FontWeight="Bold"/><WrapPanel DockPanel.Dock="Top"><Button Content="Menu" Click="PreviewMenu"/><Button Content="Backpack" Click="PreviewBackpack"/><Button Content="Chat" Click="PreviewChat"/></WrapPanel><TextBlock x:Name="PreviewContent" Text="A local historical-style sandbox. Choose Menu, Backpack or Chat." Foreground="#213A44" Margin="12"/></DockPanel></Border></StackPanel></TabItem>
   <TabItem Header="Cursors" Tag="M5,3 L5,20 L10,15 L14,22 L18,20 L14,13 L21,13 Z"><ScrollViewer><StackPanel><TextBlock Text="Legacy Cursor Manager" Style="{StaticResource Title}"/><ComboBox ItemsSource="{Binding CursorPresets}" DisplayMemberPath="Name" SelectedItem="{Binding SelectedCursor}"/><TextBlock Text="{Binding CursorDescription}"/><Border Background="#D4E4EF" BorderBrush="#91AEC4" BorderThickness="1" Width="180" Height="120" HorizontalAlignment="Left" Margin="4,12"><Image Source="{Binding CursorPreview}" Stretch="None" RenderOptions.BitmapScalingMode="NearestNeighbor"/></Border><WrapPanel><Button Content="Apply Cursor" Command="{Binding Action}" CommandParameter="ApplyCursor"/><Button Content="Restore" Command="{Binding Action}" CommandParameter="RestoreLatest"/></WrapPanel><GroupBox Header="Cursor Studio"><StackPanel><TextBlock Text="Import your PNG, resize, and place the click point at the image centre for Roblox PNG replacement. Export also saves hotspot metadata for editing; Roblox does not read that metadata."/><WrapPanel><Button Content="Import PNG…" Command="{Binding Action}" CommandParameter="ImportCursor"/><TextBlock Text="Size (8–128)" VerticalAlignment="Center"/><TextBox Text="{Binding CursorSize}" Width="50"/><TextBlock Text="Source click X / Y" VerticalAlignment="Center"/><TextBox Text="{Binding HotspotX}" Width="45"/><TextBox Text="{Binding HotspotY}" Width="45"/><Button Content="Render Preview" Command="{Binding Action}" CommandParameter="RenderCursor"/><Button Content="Export / Save Custom Preset…" Command="{Binding Action}" CommandParameter="ExportCursor"/></WrapPanel></StackPanel></GroupBox></StackPanel></ScrollViewer></TabItem>
   <TabItem Uid="CONFIGURATION" Header="FastFlags" Tag="M5,22 L5,3 L19,3 L17,8 L19,13 L5,13"><StackPanel><TextBlock Text="FastFlags — local JSON editor" Style="{StaticResource Title}"/><TextBlock Text="{Binding FlagStatus}"/><WrapPanel><TextBox Text="{Binding FlagSearch}" Width="200" ToolTip="Search flag name or value"/><ComboBox ItemsSource="{Binding FlagCategories}" SelectedItem="{Binding FlagCategory}"/><Button Content="Search / Validate" Command="{Binding Action}" CommandParameter="ValidateFlags"/><Button Content="Import…" Command="{Binding Action}" CommandParameter="ImportFlags"/><Button Content="Export…" Command="{Binding Action}" CommandParameter="ExportFlags"/></WrapPanel><TextBox Text="{Binding FlagsJson}" Style="{StaticResource Editor}" Height="260"/><TextBlock Text="{Binding FlagResults}"/><TextBlock Text="No FastFlags are written to Roblox. Keep exports as backups; import one to restore the local editor."/></StackPanel></TabItem>
   <TabItem Header="Presets" Tag="M5,3 L19,3 L19,21 L5,21 Z M9,8 L15,8 M9,12 L15,12 M9,16 L15,16"><StackPanel><TextBlock Text="Preset Manager" Style="{StaticResource Title}"/><ComboBox ItemsSource="{Binding PresetNames}" SelectedIndex="0" SelectedItem="{Binding SelectedPresetName}"/><WrapPanel><Button Content="Load" Command="{Binding Action}" CommandParameter="LoadPreset"/><Button Content="Apply" Command="{Binding Action}" CommandParameter="ApplyPreset"/><Button Content="New" Command="{Binding Action}" CommandParameter="NewPreset"/><Button Content="Duplicate" Command="{Binding Action}" CommandParameter="DuplicatePreset"/><Button Content="Save / Rename" Command="{Binding Action}" CommandParameter="SavePreset"/><Button Content="Delete" Command="{Binding Action}" CommandParameter="DeletePreset"/><Button Content="Import…" Command="{Binding Action}" CommandParameter="ImportPreset"/><Button Content="Export…" Command="{Binding Action}" CommandParameter="ExportPreset"/></WrapPanel><TextBlock Text="Edit name and properties below. ClassicPreview is local only. Nonempty Flags block application until allowlist verification. Cursor application is backed up and can be undone."/><TextBox Text="{Binding PresetJson}" Style="{StaticResource Editor}" Height="300"/><Button Content="Restore Previous Client State" HorizontalAlignment="Left" Command="{Binding Action}" CommandParameter="RestoreLatest"/></StackPanel></TabItem>
   <TabItem Header="Mods" Tag="M4,7 L12,3 L20,7 L20,17 L12,21 L4,17 Z M4,7 L12,11 L20,7 M12,11 L12,21"><StackPanel><TextBlock Text="Compatible Mod Packages" Style="{StaticResource Title}"/><TextBlock Text="ZIP packages contain mod.json and up to two cursor PNG files. Exact version matching is mandatory. Scripts, executables, extra files and paths outside cursor targets are rejected."/><WrapPanel><Button Content="Inspect ZIP…" Command="{Binding Action}" CommandParameter="InspectMod"/><Button Content="Install / Enable" Command="{Binding Action}" CommandParameter="ApplyMod"/><Button Content="Disable Latest Change" Command="{Binding Action}" CommandParameter="RestoreLatest"/><Button Content="Remove Imported Package" Command="{Binding Action}" CommandParameter="RemoveMod"/></WrapPanel><TextBox Text="{Binding ModDetails, Mode=OneWay}" IsReadOnly="True" Style="{StaticResource Editor}" Height="250"/><TextBlock Text="Disable restores the latest journal, including cursor/preset changes. Select a specific change in Diagnostics. Package content is held in memory and never executed."/></StackPanel></TabItem>
   <TabItem Uid="TOOLS" Header="Diagnostics" Tag="M2,12 L6,12 L9,5 L14,20 L17,12 L22,12"><StackPanel><TextBlock Text="Diagnostics &amp; Backups" Style="{StaticResource Title}"/><WrapPanel><Button Content="Run Diagnostics" Command="{Binding Action}" CommandParameter="Diagnostics"/><Button Content="View Logs" Command="{Binding Action}" CommandParameter="Logs"/><Button Content="Open Data Folder" Command="{Binding Action}" CommandParameter="DataFolder"/></WrapPanel><TextBox Text="{Binding DiagnosticText, Mode=OneWay}" IsReadOnly="True" Style="{StaticResource Editor}" Height="130"/><ListBox ItemsSource="{Binding Backups}" SelectedItem="{Binding SelectedBackup}" Height="190"/><WrapPanel><Button Content="Refresh Backups" Command="{Binding Action}" CommandParameter="Backups"/><Button Content="Create" Command="{Binding Action}" CommandParameter="Snapshot"/><Button Content="Restore Selected" Command="{Binding Action}" CommandParameter="RestoreSelected"/><Button Content="Delete Restored Backup" Command="{Binding Action}" CommandParameter="DeleteBackup"/></WrapPanel></StackPanel></TabItem>
   <TabItem Header="Settings" Tag="M4,6 L20,6 M4,12 L20,12 M4,18 L20,18 M8,3 L8,9 M16,9 L16,15 M10,15 L10,21"><ScrollViewer><StackPanel><TextBlock Text="Settings" Style="{StaticResource Title}"/><GroupBox Header="Launcher / Startup"><StackPanel>
 <CheckBox Content="Show startup loading screen" IsChecked="{Binding Config.ShowSplashScreen}"/>
 <TextBlock Text="Startup screen style"/><ComboBox ItemsSource="{Binding SplashStyles}" SelectedItem="{Binding Config.SplashStyle}"/>
 <TextBlock Text="Startup title"/><TextBox Text="{Binding Config.SplashTitle}"/>
 <CheckBox Content="Keep Soultrap above other windows" IsChecked="{Binding Config.AlwaysOnTop}"/>
 </StackPanel></GroupBox><GroupBox Header="Appearance"><StackPanel><ComboBox ItemsSource="{Binding Themes}" SelectedItem="{Binding Config.Theme}"/><TextBlock Text="Custom accent (#RRGGBB)"/><TextBox Text="{Binding Config.CustomAccent}"/><TextBlock Text="Opacity (0.75–1.0)"/><Slider Minimum="0.75" Maximum="1" Value="{Binding Config.Opacity}"/><TextBlock Text="Interface scale (0.85–1.50)"/><Slider Minimum="0.85" Maximum="1.5" Value="{Binding Config.UiScale}" TickFrequency="0.05" IsSnapToTickEnabled="True"/>
 <TextBlock Text="Sidebar width (180–280)"/><Slider Minimum="180" Maximum="280" Value="{Binding Config.SidebarWidth}"/>
 <TextBlock Text="Editor font size (10–24)"/><Slider Minimum="10" Maximum="24" Value="{Binding Config.EditorFontSize}" TickFrequency="1" IsSnapToTickEnabled="True"/>
 <CheckBox Content="Wrap lines in JSON editors" IsChecked="{Binding Config.EditorWordWrap}"/>
 <CheckBox Content="Software rendering (compatibility mode)" IsChecked="{Binding Config.SoftwareRendering}"/>
 <CheckBox Content="Animate theme transitions" IsChecked="{Binding Config.Animations}"/><CheckBox Content="Interface notification sounds" IsChecked="{Binding Config.Sounds}"/></StackPanel></GroupBox><GroupBox Header="General / Roblox"><StackPanel><TextBlock Text="Interface language: English (additional translations unavailable)"/><CheckBox Content="Check Soultrap updates on startup" IsChecked="{Binding Config.CheckUpdates}"/><CheckBox Content="Start with Windows" IsChecked="{Binding AutoStart}"/><CheckBox Content="Minimize to notification area" IsChecked="{Binding MinimizeToTray}"/><CheckBox Content="Confirm before launching Roblox" IsChecked="{Binding Config.ConfirmLaunches}"/>
 <TextBlock Text="After launching Roblox"/><ComboBox ItemsSource="{Binding AfterLaunchOptions}" SelectedItem="{Binding Config.AfterLaunch}"/>
 <TextBlock Text="Client process priority (takes effect on next direct launch)"/><ComboBox ItemsSource="{Binding ProcessPriorities}" SelectedItem="{Binding Config.ProcessPriority}"/>
 <TextBlock Text="Roblox version directory or Versions directory (blank = auto-detect)"/><TextBox Text="{Binding Config.RobloxPath}"/><TextBlock Text="Optional roblox-player launch URI (contains sensitive tickets: never paste it into logs)"/><TextBox Text="{Binding Config.LaunchUri}"/><Button Content="Launch Configured URI" HorizontalAlignment="Left" Command="{Binding Action}" CommandParameter="LaunchUri"/></StackPanel></GroupBox><WrapPanel><Button Content="Save / Apply Settings" Command="{Binding Action}" CommandParameter="SaveSettings"/><Button Content="Import Configuration…" Command="{Binding Action}" CommandParameter="ImportSettings"/><Button Content="Export Configuration…" Command="{Binding Action}" CommandParameter="ExportSettings"/><Button Content="Reset Launcher Settings" Command="{Binding Action}" CommandParameter="ResetSettings"/></WrapPanel></StackPanel></ScrollViewer></TabItem>
 <TabItem Header="Integrations" Tag="M4,12 L10,12 M14,12 L20,12 M8,8 L12,4 L16,8 M12,4 L12,20"><ScrollViewer><StackPanel>
  <TextBlock Text="Integrations &amp; shortcuts" Style="{StaticResource Title}"/>
  <GroupBox Header="Local activity tracking"><StackPanel><CheckBox Content="Monitor Roblox process status" IsChecked="{Binding Config.TrackRobloxProcess}"/><TextBlock Text="Updates Home while Soultrap is open. No account names or activity are uploaded."/><TextBlock Text="{Binding RobloxStatus, Mode=OneWay}"/></StackPanel></GroupBox>
  <GroupBox Header="Windows shortcuts"><StackPanel><TextBlock Text="Create shortcuts to this installed Soultrap.exe."/><WrapPanel><Button Content="Create desktop shortcut" Command="{Binding Action}" CommandParameter="DesktopShortcut"/><Button Content="Create Start menu shortcut" Command="{Binding Action}" CommandParameter="StartMenuShortcut"/></WrapPanel></StackPanel></GroupBox>
  <TextBlock Text="Discord Rich Presence, arbitrary program integrations, cookie access and game-account features are not implemented. Their upstream options are listed with explicit status in Upstream Settings."/>
 </StackPanel></ScrollViewer></TabItem>
 <TabItem Header="Maintenance" Tag="M20,8 A8,8 0 1 0 20,16 M20,3 L20,8 L15,8"><ScrollViewer><StackPanel>
  <TextBlock Text="Storage &amp; maintenance" Style="{StaticResource Title}"/>
  <GroupBox Header="Log cleaner"><StackPanel><TextBlock Text="Keep logs for this many days (1–365)"/><TextBox Width="110" HorizontalAlignment="Left" Text="{Binding Config.LogRetentionDays}"/><TextBlock Text="Deletes only older .log/.jsonl/.previous files directly inside Soultrap and Roblox log folders. Current Soultrap log, client versions, backups and user content are retained. Close Roblox first."/><Button HorizontalAlignment="Left" Content="Clean old logs…" Command="{Binding Action}" CommandParameter="CleanLogs"/></StackPanel></GroupBox>
  <WrapPanel><Button Content="Open Soultrap data" Command="{Binding Action}" CommandParameter="DataFolder"/><Button Content="Open Roblox logs" Command="{Binding Action}" CommandParameter="RobloxLogs"/><Button Content="Open backups" Command="{Binding Action}" CommandParameter="BackupsFolder"/></WrapPanel>
 </StackPanel></ScrollViewer></TabItem>
 <TabItem Header="Upstream Settings" Tag="M4,4 L20,4 L20,20 L4,20 Z M8,8 L16,8 M8,12 L16,12 M8,16 L16,16"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel><TextBlock Text="Bloxstrap · Fishstrap · Voidstrap" Style="{StaticResource Title}"/><TextBlock Text="Inventory of actual upstream settings. Adapted options work in Soultrap; other rows are reference entries, not active switches."/></StackPanel>
  <WrapPanel Grid.Row="1"><TextBox Text="{Binding UpstreamSearch, UpdateSourceTrigger=PropertyChanged}" Width="230" ToolTip="Search setting names or behavior"/><ComboBox ItemsSource="{Binding UpstreamProjects}" SelectedItem="{Binding UpstreamProject}"/><Button Content="Import supported upstream settings…" Command="{Binding Action}" CommandParameter="ImportUpstream"/></WrapPanel>
  <TextBlock Grid.Row="2" Text="{Binding UpstreamSummary, Mode=OneWay}" Foreground="{DynamicResource Muted}"/>
  <ListView Grid.Row="3" ItemsSource="{Binding VisibleUpstreamSettings}"><ListView.View><GridView><GridViewColumn Header="Project" DisplayMemberBinding="{Binding Project}" Width="90"/><GridViewColumn Header="Setting" DisplayMemberBinding="{Binding Name}" Width="230"/><GridViewColumn Header="Status" DisplayMemberBinding="{Binding Status}" Width="130"/><GridViewColumn Header="Soultrap behavior" DisplayMemberBinding="{Binding Destination}" Width="430"/></GridView></ListView.View></ListView>
  <TextBlock Grid.Row="4" Text="Source commits, MIT notices and exact compatibility mapping: SETTINGS-COMPATIBILITY.md. Unsupported upstream keys are reported during import and never silently activated."/>
 </Grid></TabItem>

 <TabItem Header="Updates" Uid="SOULTRAP" Tag="M12,3 L12,15 M7,10 L12,15 L17,10 M4,17 L4,21 L20,21 L20,17"><ScrollViewer><StackPanel><TextBlock Text="Soultrap updates" Style="{StaticResource Title}"/><TextBlock Text="Download and install directly from the official GitHub release. No ZIP or manual file copying."/><TextBlock Text="{Binding UpdateText, Mode=OneWay}" Margin="0,16"/><WrapPanel><Button Content="Check for updates" Command="{Binding Action}" CommandParameter="Updates"/><Button Content="Download and install update" Command="{Binding Action}" CommandParameter="InstallUpdate" IsEnabled="{Binding UpdateAvailable}" Style="{StaticResource PrimaryButton}"/></WrapPanel><TextBlock Text="Installation always asks for confirmation. The SHA-256 digest is checked against GitHub metadata and rechecked before launch. Publisher identity is not pinned; Windows may still warn. Your settings and backups are retained." Foreground="{DynamicResource Muted}" Margin="0,16"/></StackPanel></ScrollViewer></TabItem>

  </TabControl>
 </DockPanel>
</Window>
